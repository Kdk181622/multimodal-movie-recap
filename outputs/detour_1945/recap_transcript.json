      "no_speech_prob": 0.07,
      "words": []
    },
    {
      "id": 3,
      "start": 63.8,
      "end": 66.82,
      "text": "It's a funny way to talk, darling. Don't you want to marry me?",
      "avg_logprob": -0.161,
      "no_speech_prob": 0.07,
      "words": []
    },
    {
      "id": 4,
      "start": 67.14,
      "end": 70.32,

    },
    {
      "id": 10,
      "start": 86.84,
      "end": 88.86,
      "text": "That's the most stupid thing I ever heard of.",
      "avg_logprob": -0.291,
      "no_speech_prob": 0.041,
      "words": []
    },
    {
      "id": 0,
      "start": 89.32,
